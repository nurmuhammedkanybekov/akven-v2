# Copy this file to .env (it is ignored by git) and fill in what you need. Never commit real keys.
# docker compose reads .env automatically.

# rule = built-in deterministic assistant (default, needs nothing)
# llm  = language model, with the rule-based assistant as fallback if the model fails
NEGOTIATION_PROVIDER=rule

# Any OpenAI-compatible API. Defaults: Google Gemini.
# LLM_API_KEY=your-key-here
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#
# Local and free with Ollama (no key needed): run `ollama pull llama3.2`, then from Docker use
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=llama3.2
