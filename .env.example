# Copy this file to .env (it is ignored by git) and fill in what you need. Never commit real keys.
# docker compose reads .env automatically.

# A real shop (not a demo): no demo catalog or demo accounts, and its own database password, set before the very
# first start. See docs/development.md, "Running it for real".
# SPRING_PROFILES_ACTIVE=prod
# DB_PASSWORD=a-long-random-password
# AKVEN_BIND=127.0.0.1

# rule = built-in deterministic assistant (default, needs nothing)
# llm  = language model, with the rule-based assistant as fallback if the model fails
NEGOTIATION_PROVIDER=rule

# Any OpenAI-compatible API. Defaults: Google Gemini.
# LLM_API_KEY=your-key-here
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#
# Local and free with Ollama (no key needed): run `ollama pull llama3.2`, then from Docker use
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=llama3.2

# The shop's real contacts, in the order shown on the site: "KIND|label|value" entries separated by ";".
# Kinds: WHATSAPP, PHONE, TELEGRAM, INSTAGRAM, FACEBOOK, EMAIL. Applied on start whenever this line changes;
# in between, the owners edit contacts in the admin. Keep the quotes.
# SHOP_CONTACTS='WHATSAPP|Name|+996700123456;INSTAGRAM|Instagram|akven.socks;TELEGRAM|Telegram|yourname'

# The super admin (you): created on first start if the account does not exist yet. At least 12 characters.
# SUPER_ADMIN_EMAIL=you@example.com
# SUPER_ADMIN_PASSWORD=choose-a-long-password
# SUPER_ADMIN_NAME=Your name
# With a super admin set, the @akven.test demo accounts are switched off. DEMO_ACCOUNTS=on keeps them (for presenting).
# DEMO_ACCOUNTS=on
